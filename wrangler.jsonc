{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weeks",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-04",
  "observability": {
    "enabled": true
  },

  // Add this section
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "442418eda9534b3aa746c83c4a70c438",

      // Optional. Can be used to connect to a local database for local development
      "localConnectionString": "postgresql://user:password@localhost:5432/databasename"
    }
  ],

  // Smart Placement: Run your Worker close to your database for lower latency
  "placement": {
    "region": "aws:us-east-1"
  }
}
